# Copy this file to .env and add your Anthropic API key.
# Never paste your API key into React/frontend code or commit .env to Git.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5-5
PORT=3001
# Database (code-first, created automatically). Default: ./data/studentfin.db
# DB_PATH=./data/studentfin.db
# Or PostgreSQL: DATABASE_URL=postgres://user:pass@host:5432/studentfin (also: npm install pg pg-hstore)

# Session signing secret (min 32 chars). If empty, one is generated in data/.jwt-secret
JWT_SECRET=
